```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.class
*.so
*.dll
*.exe
*.out
*.a

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Build directories
dist/
build/
target/
.coverage
coverage/
htmlcov/

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Editor/IDE files
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Python specific
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.tox/
.hypothesis/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```