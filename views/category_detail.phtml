<?php
/** @var array $category */
/** @var array $goods */
?>

<h1><?= htmlspecialchars($category['name'] ?? 'Категория', ENT_QUOTES) ?></h1>

<?php if (empty($goods)): ?>
    <p>В этой категории пока нет приложений.</p>
<?php else: ?>
    <ul class="app-list">
        <?php foreach ($goods as $app): ?>
            <li class="card">
                <h3><a href="?action=app_details&app_id=<?= htmlspecialchars($app['id'] ?? '', ENT_QUOTES) ?>"><?= htmlspecialchars($app['title'] ?? '', ENT_QUOTES) ?></a></h3>
                <p>Скачиваний: <b><?= (int)($app['downloads'] ?? 0) ?></b></p>
            </li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

<p><a href="?action=categories">← Вернуться к списку категорий</a></p>
