<?php
/** @var array $category */
/** @var array $goods */
?>

<h1><?= htmlspecialchars($category['name'] ?? 'Категория', ENT_QUOTES) ?></h1>

<?php if (empty($goods)): ?>
    <p>В этой категории пока нет приложений.</p>
<?php else: ?>
    <ul class="good-list">
        <?php foreach ($goods as $good): ?>
            <li class="card">
                <h3><a href="?action=app_details&good_id=<?= htmlspecialchars($good['id'] ?? '', ENT_QUOTES) ?>"><?= htmlspecialchars($good['title'] ?? '', ENT_QUOTES) ?></a></h3>
                <p>Скачиваний: <b><?= (int)($good['downloads'] ?? 0) ?></b></p>
            </li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

<p><a href="?action=categories">← Вернуться к списку категорий</a></p>
