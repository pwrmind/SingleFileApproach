<h1>🏠 Каталог товаров</h1>

<?php if (empty($goods)): ?>
    <p>Пока нет ни одного товара.</p>
<?php else: ?>
    <?php foreach ($goods as $good): ?>
        <div class="card">
            <h3><a href="?action=good_details&good_id=<?= htmlspecialchars($good['id'] ?? '', ENT_QUOTES) ?>"><?= htmlspecialchars($good['title'] ?? '', ENT_QUOTES) ?></a></h3>
            <p>Цена: <b><?= number_format($good['price'] ?? 0, 0, '.', ' ') ?> ₽</b></p>
            <p>Продаж: <?= (int)($good['sales'] ?? 0) ?> | Остаток: <?= (int)($good['stock'] ?? 0) ?> шт.</p>
        </div>
    <?php endforeach; ?>
<?php endif; ?>