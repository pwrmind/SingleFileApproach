<h1>🔍 Поиск товаров</h1>

<form method="GET" action="">
    <input type="hidden" name="action" value="search">
    <div class="card">
        <label for="query">Поиск по названию:</label>
        <input type="text" id="query" name="q" value="<?= htmlspecialchars($query ?? '', ENT_QUOTES) ?>" placeholder="Введите название товара...">
        <button type="submit" class="btn">Найти</button>
    </div>
</form>

<?php if ($query !== null && $query !== ''): ?>
    <div style="margin-top: 20px;">
        <?php if (empty($goods)): ?>
            <p>Товаров по запросу "<b><?= htmlspecialchars($query, ENT_QUOTES) ?></b>" не найдено.</p>
        <?php else: ?>
            <p>Найдено товаров: <b><?= count($goods) ?></b></p>
            <div class="products-grid">
                <?php foreach ($goods as $good): ?>
                    <div class="product-tile">
                        <h3><a href="?action=good_details&good_id=<?= htmlspecialchars($good['id'] ?? '', ENT_QUOTES) ?>"><?= htmlspecialchars($good['title'] ?? '', ENT_QUOTES) ?></a></h3>
                        <p class="price"><?= number_format($good['price'] ?? 0, 0, '.', ' ') ?> ₽</p>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
    </div>
<?php endif; ?>
