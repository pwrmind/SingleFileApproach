<?php
/** @var array $collection */
/** @var array $goods */
?>

<h1><?= htmlspecialchars($collection['name'] ?? 'Коллекция', ENT_QUOTES) ?></h1>

<?php if (!empty($collection['description'])): ?>
    <p><?= htmlspecialchars($collection['description'] ?? '', ENT_QUOTES) ?></p>
<?php endif; ?>

<?php if (Auth::check()): ?>
    <p><a href="?action=collection_edit&collection_id=<?= htmlspecialchars($collection['id'] ?? '', ENT_QUOTES) ?>">✏️ Редактировать коллекцию</a></p>
<?php endif; ?>

<?php if (empty($goods)): ?>
    <p>В этой коллекции пока нет товаров.</p>
<?php else: ?>
    <ul class="app-list">
        <?php foreach ($goods as $good): ?>
            <li class="card">
                <h3><a href="?action=good_details&good_id=<?= htmlspecialchars($good['id'] ?? '', ENT_QUOTES) ?>"><?= htmlspecialchars($good['title'] ?? '', ENT_QUOTES) ?></a></h3>
                <p>Цена: <b><?= number_format($good['price'] ?? 0, 0, '.', ' ') ?> ₽</b></p>
            </li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

<p><a href="?action=collections">← Вернуться к списку коллекций</a></p>
